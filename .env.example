# Music backend: invidious (default), piped, or youtube (official player opt-in).
MUSIC_PROVIDER=invidious
# Required for Piped/Invidious: base API URL of an instance you operate/trust.
# Example: http://127.0.0.1:3001 (Invidious) or your Piped backend's API URL.
MUSIC_API_URL=
# Optional: trusted proxy/companion origins, comma-separated, without paths.
# The API origin and HTTPS *.googlevideo.com are already allowed.
MUSIC_STREAM_ORIGINS=
# Only used with MUSIC_PROVIDER=youtube for official API song search.
YOUTUBE_API_KEY=
